{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "mdo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ws",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/www/mdo"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "preserveSymlinks": true,
            "assets": [
              "src/favicon.png",
              "src/mdo-assets/icons/",
              "src/mdo-assets/images/"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "styles": [
              {
                "input": "src/styles/libraries.scss",
                "bundleName": "libraries",
                "inject": true
              },
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/mat-typography.scss",
              "src/styles/styles.scss",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              {
                "inject": false,
                "input": "src/themes/theme-deep-purple.scss",
                "bundleName": "theme-deep-purple"
              },
              {
                "inject": false,
                "input": "src/themes/theme-grey.scss",
                "bundleName": "theme-grey"
              },
              {
                "inject": false,
                "input": "src/themes/theme-indigo.scss",
                "bundleName": "theme-indigo"
              },
              {
                "inject": false,
                "input": "src/themes/theme-lite-blue.scss",
                "bundleName": "theme-lite-blue"
              },
              {
                "inject": false,
                "input": "src/themes/theme-orange.scss",
                "bundleName": "theme-orange"
              },
              {
                "inject": false,
                "input": "src/themes/theme-teal.scss",
                "bundleName": "theme-teal"
              },
              {
                "inject": false,
                "input": "src/themes/theme-blue.scss",
                "bundleName": "theme-blue"
              },
              {
                "inject": false,
                "input": "src/themes/theme-deep-blue.scss",
                "bundleName": "theme-deep-blue"
              },
              {
                "inject": true,
                "input": "src/themes/theme-igot.scss",
                "bundleName": "theme-igot"
              },
              "node_modules/pdfjs-dist/web/pdf_viewer.css",
              "src/mdo-assets/fonts/lato/stylesheet.css",
              "src/mdo-assets/fonts/montserrat/stylesheet.css",
              "node_modules/ckeditor5/dist/ckeditor5.css"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/shepherd.js/dist/js/shepherd.min.js",
              "node_modules/leader-line/leader-line.min.js"
            ],
            "aot": false,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "np": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.np.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "preprod": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.preprod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "benchmark": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.bm.ts"
                }
              ],
              "optimization": false,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "100mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3000,
            "buildTarget": "mdo:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "mdo:build:production"
            },
            "de": {
              "buildTarget": "mdo:build:de"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "mdo:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.png"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "mdo:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "mdo:serve:production"
            }
          }
        }
      }
    },
    "@ws/app": {
      "projectType": "library",
      "root": "project/ws/app",
      "sourceRoot": "project/ws/app/src",
      "prefix": "ws-app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/app/tsconfig.lib.json",
            "project": "project/ws/app/ng-package.json"
          }
        ,          "configurations": {
            "production": {
              "tsConfig": "project/ws/app/tsconfig.lib.prod.json"
            }
          }
},
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/app/src/test.ts",
            "tsConfig": "project/ws/app/tsconfig.spec.json",
            "karmaConfig": "project/ws/app/karma.conf.js"
          }
        }
      }
    },
     "@ws/viewer": {
      "projectType": "library",
      "root": "project/ws/viewer",
      "sourceRoot": "project/ws/viewer/src",
      "prefix": "viewer",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/viewer/tsconfig.lib.json",
            "project": "project/ws/viewer/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/ws/viewer/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/viewer/src/test.ts",
            "tsConfig": "project/ws/viewer/tsconfig.spec.json",
            "karmaConfig": "project/ws/viewer/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}